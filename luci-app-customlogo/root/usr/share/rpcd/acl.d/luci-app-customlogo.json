{
	"luci-app-customlogo": {
		"description": "Grant access to Custom Logo configuration",
		"read": {
			"uci": [ "customlogo" ],
			"file": {
				"/etc/customlogo": [ "list", "read" ],
				"/etc/customlogo/*": [ "read" ]
			}
		},
		"write": {
			"uci": [ "customlogo" ],
			"file": {
				"/etc/customlogo": [ "list", "write" ],
				"/etc/customlogo/*": [ "read", "write", "delete" ]
			}
		}
	}
}
